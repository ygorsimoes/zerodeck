[Unit]
Description=ZeroDeck loader update availability check
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
# The timer only verifies the trusted catalog and reports an available release. It never stages or
# activates anything.
EnvironmentFile=-/etc/zerodeck/update.env
ExecStart=/usr/local/lib/zerodeck/bin/zerodeckctl update --check-only --root /var/lib/zerodeck
Nice=10
