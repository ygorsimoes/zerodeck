[Unit]
Description=ZeroDeck managed loader boot recovery
After=local-fs.target
Before=zerodeck.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
TimeoutStartSec=60
# Disk-only reconciliation: never starts or stops the daemon. The ordered daemon unit owns startup
# when a good generation remains.
ExecStart=/home/.zerodeck/bin/zerodeckctl recover-boot --root /home/.zerodeck

[Install]
WantedBy=multi-user.target
