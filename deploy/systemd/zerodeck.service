[Unit]
Description=ZeroDeck Plugin Loader Daemon
After=network.target

# Paths default to the stock Steam Deck layout (`/home/deck/homebrew`). systemd does not expand
# shell-style variables in WorkingDirectory=, so to use another location create a drop-in with
# `systemctl edit zerodeck.service` and override WorkingDirectory= and both Environment= paths.

[Service]
Type=simple
User=root
Restart=always
RestartSec=2
KillMode=process
TimeoutStopSec=15
ExecStart=/usr/local/bin/zerodeckd
# The leading `-` keeps the unit starting if the directory does not exist yet.
WorkingDirectory=-/home/deck/homebrew/services
Environment=UNPRIVILEGED_PATH=/home/deck/homebrew
Environment=PRIVILEGED_PATH=/home/deck/homebrew
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
